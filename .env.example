# Copy to .env.local and fill in. Never commit real values.
#
# Every variable below is read ONLY on the server (route handlers and
# modules marked `import 'server-only'`). None is prefixed NEXT_PUBLIC_,
# so Next.js never inlines them into the browser bundle.
# `npm test` and `node scripts/check-client-bundle.mjs` enforce this.

# Supabase (database, storage, auth)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Signs the anonymous device cookie. Generate with: openssl rand -base64 32
DEVICE_COOKIE_SECRET=

# Model providers (optional: a model without its key is simply not offered)
OPENAI_API_KEY=
LTXV_API_KEY=

# Public, safe to expose: the canonical site address used for SEO tags,
# the sitemap and robots.txt. Defaults to the Vercel production domain.
NEXT_PUBLIC_SITE_URL=

# Local testing without Supabase: keep data in memory.
# SLATE_STORE=memory
